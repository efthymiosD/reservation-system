{
  "realm": "reservation",
  "enabled": true,
  "registrationAllowed": false,
  "loginWithEmailAllowed": false,
  "duplicateEmailsAllowed": true,
  "resetPasswordAllowed": false,
  "sslRequired": "external",
  "roles": {
    "realm": [
      {
        "name": "ADMIN",
        "description": "Realm administrator"
      },
      {
        "name": "CUSTOMER",
        "description": "Regular customer"
      }
    ]
  },
  "clients": [
    {
      "clientId": "reservation-api",
      "name": "Reservation System",
      "enabled": true,
      "clientAuthenticatorType": "client-secret",
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "redirectUris": [
        "/*"
      ],
      "webOrigins": [
        "/*"
      ],
      "defaultClientScopes": [
        "web-origins",
        "acr",
        "profile",
        "roles",
        "email"
      ],
      "optionalClientScopes": [
        "address",
        "phone",
        "offline_access",
        "microprofile-jwt"
      ]
    }
  ],
  "users": [
    {
      "username": "admin",
      "enabled": true,
      "emailVerified": true,
      "email": "admin@reservation.local",
      "firstName": "Reza",
      "lastName": "Admin",
      "credentials": [
        {
          "type": "password",
          "value": "admin",
          "temporary": false
        }
      ],
      "realmRoles": [
        "ADMIN"
      ]
    },
    {
      "username": "alice",
      "enabled": true,
      "emailVerified": true,
      "email": "alice@reservation.local",
      "firstName": "Alice",
      "lastName": "Customer",
      "credentials": [
        {
          "type": "password",
          "value": "alice",
          "temporary": false
        }
      ],
      "realmRoles": [
        "CUSTOMER"
      ]
    }
  ]
}
