# Variable vocabulary (PLAIN placeholders — never commit real values).
# Copy to .env and fill in real values. Never commit .env.
#
# Variable classes: DEV (default docker-compose.yml), DEPLOY (QNAP/dev
# deployment stack, docker-compose.deploy.yml), PUBLIC (browser-facing URLs
# through the Cloudflare tunnel), INTERNAL (compose-network service URLs).
# A URL variable carries exactly ONE meaning; they are NOT interchangeable.

# --- Database (dev + deploy) ---
POSTGRES_DB=reservation
POSTGRES_USER=reservation
POSTGRES_PASSWORD=change-me

# --- App datasource ---
# DEV local app: jdbc:postgresql://localhost:5432/reservation
# DEPLOY:        jdbc:postgresql://postgres:5432/reservation (compose file sets this)
DB_URL=jdbc:postgresql://localhost:5432/reservation
DB_USERNAME=reservation
DB_PASSWORD=change-me

# --- OIDC (Keycloak) ---
# PUBLIC base of the auth hostname (the `iss` Keycloak pins):
KC_PUBLIC_BASE_URL=https://auth.example.com
# Issuer URI must equal <KC_PUBLIC_BASE_URL>/realms/reservation.
JWT_ISSUER_URI=http://localhost:8081/realms/reservation
# Browser-facing legs (PUBLIC):
KEYCLOAK_AUTHORIZATION_URI=http://localhost:8081/realms/reservation/protocol/openid-connect/auth
KEYCLOAK_END_SESSION_URI=http://localhost:8081/realms/reservation/protocol/openid-connect/logout
# Server legs (INTERNAL: compose service name on the QNAP; localhost locally):
KEYCLOAK_TOKEN_URI=http://localhost:8081/realms/reservation/protocol/openid-connect/token
KEYCLOAK_JWK_SET_URI=http://localhost:8081/realms/reservation/protocol/openid-connect/certs
# Expected `aud` for access tokens.
APP_AUDIENCE=reservation-api
# Web client (Thymeleaf UI, authorization code flow).
KC_WEB_CLIENT_ID=reservation-web
KC_WEB_CLIENT_SECRET=dev-web-secret
# Redirect derivation: {baseUrl} resolves from forwarded headers. Override
# only with a fixed URI.
KC_WEB_REDIRECT_URI={baseUrl}/login/oauth2/code/keycloak

# --- Cloudflare tunnel (DEPLOY only) ---
CLOUDFLARED_TUNNEL_TOKEN=change-me

# --- Keycloak console bootstrap (dev defaults; rotate on the QNAP) ---
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me

# --- Docs/UI (production profile switch, off unless needed) ---
SPRINGDOC_ENABLED=false
