# Copy to .env and fill in real values. Never commit .env.
# Used by docker-compose.yml and the application (via spring profiles / env).

# --- Database (docker-compose postgres + app datasource) ---
POSTGRES_DB=reservation
POSTGRES_USER=reservation
POSTGRES_PASSWORD=change-me

# --- App datasource (defaults match docker-compose dev) ---
DB_URL=jdbc:postgresql://localhost:5432/reservation
DB_USERNAME=reservation
DB_PASSWORD=change-me

# --- OIDC (Keycloak) ---
# Issuer URI. Leave empty only for local dev (falls back to dev public key).
JWT_ISSUER_URI=http://localhost:8081/realms/reservation
# Expected `aud` (client id) for access tokens.
APP_AUDIENCE=reservation-api

# --- Keycloak admin (docker-compose) ---
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me
